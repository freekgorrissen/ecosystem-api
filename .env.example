# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# NS (Nederlandse Spoorwegen) API Key
# Get your API key from: https://apiportal.ns.nl/
NS_API_KEY=your_ns_api_key_here

# Path to the people config (home/work commutes); see people.example.json
PEOPLE_CONFIG=people.json

# Google sign-in: the client app's OAuth client ID (VITE_GOOGLE_CLIENT_ID in the client)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
# Comma-separated Google accounts allowed to use the API
ALLOWED_EMAILS=you@example.com,partner@example.com

# Optional: API Configuration
# PORT=8000
# HOST=0.0.0.0
# DEBUG=False